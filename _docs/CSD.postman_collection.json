{
  "info": {
    "name": "CSD Backend",
    "description": "API REST para gestión de grupos scout. Base URL configurable en variable {{baseUrl}}.\nEl token JWT se auto-guarda al hacer login (test script).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "token", "value": "", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "🔐 Auth",
      "item": [
        {
          "name": "POST /auth/login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var resp = JSON.parse(responseBody);",
                  "if (resp.data && resp.data.token) {",
                  "    pm.collectionVariables.set('token', resp.data.token);",
                  "    console.log('Token JWT guardado');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"correo_electronico\":\"admin@csd.local\",\"contrasena\":\"Admin123!\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "POST /auth/register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"nombre_usuario\":\"nuevo\",\"correo_electronico\":\"nuevo@csd.local\",\"contrasena\":\"Test123!\",\"codigo_invitacion\":\"ABCD1234\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        }
      ]
    },
